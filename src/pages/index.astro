---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Hero from '../components/Hero.astro';
import VehicleCard from '../components/VehicleCard.astro';
import NewsCard from '../components/NewsCard.astro';
import { vehicles } from '../data/vehicles';
import { news } from '../data/news';
import { brands } from '../data/brands';

const popularVehicles = vehicles.filter((v) => v.popular).slice(0, 6);
const latestNews = [...news].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()).slice(0, 3);
const featured = news[0];
const spotlightVehicles = popularVehicles.slice(0, 2);
---

<Layout description="Portal otomotif terpercaya untuk berita, review, katalog, perbandingan, dan simulasi kredit mobil serta motor.">
 <Hero />

 <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
 <div class="mb-8 flex items-end justify-between gap-4">
 <div>
 <p class="text-xs font-semibold uppercase tracking-wide text-accent-600">Sorotan</p>
 <h2 class="mt-1 text-xl font-bold text-neutral-900 sm:text-2xl">Konten Pilihan Redaksi</h2>
 </div>
 </div>
 <div class="grid gap-6 lg:grid-cols-3">
 <a href={`/news/${featured.slug}`} class="group relative col-span-1 overflow-hidden rounded-2xl border border-neutral-200 lg:col-span-2">
 <img
 src={featured.image}
 alt={featured.title}
 class="aspect-[16/9] w-full object-cover transition-transform duration-300 group-hover:scale-105"
 width="900"
 height="506"
 />
 <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-transparent"></div>
 <div class="absolute inset-x-0 bottom-0 p-6">
 <span class="inline-flex items-center rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-neutral-900">{featured.category}</span>
 <h3 class="mt-3 text-lg font-bold leading-snug text-white sm:text-xl">{featured.title}</h3>
 </div>
 </a>
 <div class="flex flex-col gap-4">
 {
 spotlightVehicles.map((v) => (
 <a
 href={`/vehicles/${v.slug}`}
 class="group flex items-center gap-3 rounded-2xl border border-neutral-200 bg-white p-3 transition-colors hover:border-accent-500"
 >
 <img src={v.image} alt={v.name} class="h-16 w-20 shrink-0 rounded-xl object-cover" width="120" height="90"/>
 <span class="min-w-0">
 <span class="block truncate text-sm font-semibold text-neutral-900">{v.name}</span>
 <span class="block text-xs text-neutral-500">
 {v.brand} &middot; {v.year}
 </span>
 </span>
 <Icon name="ChevronRight" size={16} class="ml-auto shrink-0 text-neutral-300 transition-transform group-hover:translate-x-1"/>
 </a>
 ))
 }
 <a href="/calculator" class="flex items-center gap-3 rounded-2xl border border-accent-200 bg-accent-50 p-4">
 <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent-600 text-white">
 <Icon name="Calculator" size={18} />
 </span>
 <span>
 <span class="block text-sm font-semibold text-neutral-900">Hitung Simulasi Kredit</span>
 <span class="block text-xs text-neutral-500">Estimasi cicilan bulanan Anda</span>
 </span>
 </a>
 </div>
 </div>
 </section>

 <section class="border-t border-neutral-200 bg-neutral-50">
 <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
 <div class="mb-8 flex items-end justify-between gap-4">
 <div>
 <p class="text-xs font-semibold uppercase tracking-wide text-accent-600">Update</p>
 <h2 class="mt-1 text-xl font-bold text-neutral-900 sm:text-2xl">Berita Terbaru</h2>
 </div>
 <a href="/news" class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent-600 hover:underline">
 Lihat Semua <Icon name="ChevronRight" size={16} />
 </a>
 </div>
 <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
 {latestNews.map((article) => <NewsCard article={article} />)}
 </div>
 </div>
 </section>

 <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
 <div class="mb-8 flex items-end justify-between gap-4">
 <div>
 <p class="text-xs font-semibold uppercase tracking-wide text-accent-600">Pilihan</p>
 <h2 class="mt-1 text-xl font-bold text-neutral-900 sm:text-2xl">Kendaraan Populer</h2>
 </div>
 <a href="/vehicles" class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent-600 hover:underline">
 Lihat Semua <Icon name="ChevronRight" size={16} />
 </a>
 </div>
 <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
 {popularVehicles.map((vehicle) => <VehicleCard vehicle={vehicle} />)}
 </div>
 </section>

 <section class="border-t border-neutral-200 bg-neutral-50">
 <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
 <div class="mb-8">
 <p class="text-xs font-semibold uppercase tracking-wide text-accent-600">Brand</p>
 <h2 class="mt-1 text-xl font-bold text-neutral-900 sm:text-2xl">Brand Otomotif Populer</h2>
 </div>
 <div class="grid grid-cols-2 gap-4 sm:grid-cols-4 lg:grid-cols-8">
 {
 brands.map((brand) => (
 <a
 href={`/vehicles?brand=${brand.slug}`}
 class="flex flex-col items-center gap-3 rounded-2xl border border-neutral-200 bg-white p-4 text-center transition-colors hover:border-accent-500"
 >
 <span class="flex h-12 w-full items-center justify-center">
 <img
 src={brand.logo}
 alt={`Logo ${brand.name}`}
 class="h-8 max-w-[80%] object-contain"
 loading="lazy"
 width="80"
 height="32"
 />
 </span>
 <span class="text-xs font-semibold text-neutral-700">{brand.name}</span>
 </a>
 ))
 }
 </div>
 </div>
 </section>
</Layout>
