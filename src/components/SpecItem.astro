---
import Icon from './Icon.astro';

export interface Props {
 icon: string;
 label: string;
 value: string;
}

const { icon, label, value } = Astro.props;
---

<div class="flex items-center gap-3 rounded-xl border border-neutral-200 p-3">
 <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-accent-50 text-accent-600">
 <Icon name={icon} size={16} />
 </span>
 <span class="min-w-0">
 <span class="block text-xs text-neutral-500">{label}</span>
 <span class="block truncate text-sm font-semibold text-neutral-900">{value}</span>
 </span>
</div>
